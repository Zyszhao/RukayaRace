<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="RukayaArchiveBuildingBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <rotatable>false</rotatable>
    <passability>Impassable</passability>
    <fillPercent>0.6</fillPercent>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <statBases>
      <MaxHitPoints>700</MaxHitPoints>
      <Flammability>0</Flammability>
      <Beauty>-6</Beauty>
    </statBases>
    <building>
      <neverBuildable>true</neverBuildable>
      <claimable>false</claimable>
      <deconstructible>false</deconstructible>
      <repairable>false</repairable>
      <allowAutoroof>false</allowAutoroof>
    </building>
  </ThingDef>
  <ThingDef ParentName="RukayaArchiveBuildingBase">
    <defName>Rukaya_Archive_Refining</defName>
    <label>abandoned large refiner</label>
    <!-- 中文：废弃大型精炼器 -->
    <description>An inactive machine. Investigate it to recover one memory module containing refining records.</description>
    <!-- 中文：一台失效的设备。调查可获得一份保存大规模精炼资料的磁芯存储器。 -->
    <graphicData>
      <texPath>Rukaya/Building/Abandoned/Rukaya_Ancient_LargeRefinary</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(6,6)</drawSize>
      <drawOffset>(0,0,0.30)</drawOffset>
      <shadowData>
        <volume>(6.03, 1.0, 5.25)</volume>
        <offset>(0, 0, -0.25)</offset>
      </shadowData>
      <damageData>
        <rect>(0.3,0,5.4,6)</rect>
      </damageData>
    </graphicData>
    <size>(6,6)</size>
    <comps>
      <li Class="RukayaRace.Research.CompProperties_RukayaArchiveInvestigation">
        <memory>Rukaya_CoreMemory_Refining</memory>
        <workRequired>6000</workRequired>
      </li>
    </comps>
  </ThingDef>
