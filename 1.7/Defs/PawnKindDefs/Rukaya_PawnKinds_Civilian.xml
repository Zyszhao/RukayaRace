<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================================
       平民层（Civilian）：无武装，只承担定居点与市民生态
       对应 设计文档/设定.md 的四层身份结构第一层。
       现有 Rukaya_Colonist / Rukaya_Refugee 保持原样，未在此文件内改动。
       ============================================================================ -->

  <!-- 小镇居民：供 Peaceful / Settlement 生成组填充定居点人口，
       避免定居点里只有士兵与殖民者。 -->
  <PawnKindDef ParentName="Rukaya_PawnBase">
    <defName>Rukaya_Towner</defName>
    <label>Rukaya towner</label>
    <!-- 中文：卢卡娅小镇居民 -->
    <combatPower>20</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>false</isFighter>
    <factionLeader>false</factionLeader>
    <apparelMoney>1200~2000</apparelMoney>
    <apparelTags>
      <li>Rukaya_Dress_Civilian</li>
      <li>Rukaya_Underwear</li>
    </apparelTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <!-- 平民躯干锁位用 Rukaya_Dress_Civilian，而不是泛用的 Rukaya_OnSkin：
             specificApparelRequirements 会绕过 apparelTags 白名单直接取物，
             使用身份词条可避免把其它躯干服装当作平民制服。另用 apparelDisallowTags
             堵住动力甲的预算循环（两条防线，见 Rukaya_PawnKinds_Military.xml 顶部说明）。
             再用 apparelLayer 钉死贴身层：Rukaya_Dress_Civilian 也挂在 CasualJacket /
             WinterCape 两件 Shell 外套上，不钉层会抽到外套，生成出只穿一件外套的居民。 -->
        <apparelLayer>OnSkin</apparelLayer>
        <requiredTag>Rukaya_Dress_Civilian</requiredTag>
      </li>
    </specificApparelRequirements>
    <apparelDisallowTags>
      <li>Rukaya_PowerArmor</li>
    </apparelDisallowTags>
    <weaponTags>
    </weaponTags>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>Rukaya_ChildGeneral</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>Rukaya_AdultGeneral</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
    <inventoryOptions>
      <subOptionsChooseOne>
        <li>
          <choiceChance>100</choiceChance>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>25</min>
            <max>80</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>

</Defs>
