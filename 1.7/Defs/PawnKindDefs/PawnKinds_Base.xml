<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <PawnKindDef Name="Rukaya_PawnBase" Abstract="True">
    <race>Alien_Rukaya</race>
    <fixedGender>Female</fixedGender>
    <!-- defaultFactionType 是 defaultFactionDef 的 LoadAlias。
         2026-10-08 派系语义互换后，这里必须跟着换成 NPC 阵营 Rukaya_DrifterAlliance：
         互换前这个名字指的是 NPC 阵营，本行原本就让所有卢卡娅兵种默认归 NPC 卢卡娅，
         换成 Rukaya_PlayerFaction（= 现在的玩家阵营）会让这些兵种被 base gen / 部分开发者工具
         当成"玩家阵营兵种"而排除掉。 -->
    <defaultFactionType>Rukaya_DrifterAlliance</defaultFactionType>
    <backstoryCryptosleepCommonality>0</backstoryCryptosleepCommonality>
    <invNutrition>0</invNutrition>
    <gearHealthRange>0.8~1.0</gearHealthRange>
    <apparelIgnoreSeasons>true</apparelIgnoreSeasons>
    <initialWillRange>3~5</initialWillRange>
    <initialResistanceRange>12~20</initialResistanceRange>
    <maxGenerationAge>50</maxGenerationAge>
    <minGenerationAge>18</minGenerationAge>
    <styleItemTags>
      <li>
        <tag>Rukaya</tag>
        <baseWeight>1</baseWeight>
        <weightFactor>1</weightFactor>
      </li>
    </styleItemTags>
    <xenotypeSet>
      <xenotypeChances>
        <Baseliner MayRequire="Ludeon.RimWorld.Biotech">1</Baseliner>
        <Dirtmole MayRequire="Ludeon.RimWorld.Biotech">0</Dirtmole>
        <Genie MayRequire="Ludeon.RimWorld.Biotech">0</Genie>
        <Hussar MayRequire="Ludeon.RimWorld.Biotech">0</Hussar>
        <Sanguophage MayRequire="Ludeon.RimWorld.Biotech">0</Sanguophage>
        <Neanderthal MayRequire="Ludeon.RimWorld.Biotech">0</Neanderthal>
        <Pigskin MayRequire="Ludeon.RimWorld.Biotech">0</Pigskin>
        <Impid MayRequire="Ludeon.RimWorld.Biotech">0</Impid>
        <Waster MayRequire="Ludeon.RimWorld.Biotech">0</Waster>
        <Yttakin MayRequire="Ludeon.RimWorld.Biotech">0</Yttakin>
        <Highmate MayRequire="Ludeon.RimWorld.Biotech">0</Highmate>
      </xenotypeChances>
    </xenotypeSet>
    <useFactionXenotypes>false</useFactionXenotypes>
    <!-- 种族能力：紧急飞行。
         挂在抽象基类 Rukaya_PawnBase 上，所有子兵种（殖民者 / 难民 / 士兵 / 居民…）自动继承，
         这样"每个卢卡娅都有一对翅膀、也都能用翅膀突进"这件事只有一个声明点。
         能力本身的门禁（翅膀是否完好、饱食 / 休息阈值）在
         Rukaya_Abilities.xml 的两个能力 comp 里，需要时按需授予也不用在这里重复。 -->
    <abilities>
      <li>Rukaya_EmergencyFly</li>
    </abilities>
  </PawnKindDef>

  <PawnKindDef ParentName="Rukaya_PawnBase">
    <defName>Rukaya_Colonist</defName>
    <label>Rukaya Colonist</label>
    <!-- 中文：卢卡娅殖民者 -->
    <!-- 原版调试生成器按 PawnKindDef.defaultFactionDef 选派系；殖民者需显式归玩家派系。 -->
    <defaultFactionType>Rukaya_PlayerFaction</defaultFactionType>
    <combatPower>50</combatPower>
    <itemQuality>Normal</itemQuality>
    <isFighter>false</isFighter>
    <factionLeader>false</factionLeader>
    <apparelMoney>2500~3000</apparelMoney>
    <!-- apparelTags / requiredTag 必须使用本模组实际存在的服装 tag
         （Rukaya_OnSkin / Rukaya_OverHead / Rukaya_Shell / Rukaya_Underwear / Rukaya_Middle，
         动力甲 Rukaya_PowerArmor）。
         写成不存在的 tag 会让 PawnApparelGenerator 剔掉全部候选，殖民者直接裸体生成。

         注意：躯干锁位应使用身份词条，而不是泛用的 Rukaya_OnSkin。动力甲现在继承
         Rukaya_Shell 并带有 Rukaya_PowerArmor；specificApparelRequirements 会绕过
         apparelTags 白名单与 apparelMoney 预算直接取物，因此低阶 PawnKind 不应以
         Rukaya_PowerArmor 锁位。平民使用 Rukaya_Dress_Civilian，并用
         apparelDisallowTags 堵住预算循环，详见 Rukaya_PawnKinds_Military.xml 顶部说明。
         另需 <apparelLayer>OnSkin</apparelLayer> 钉死贴身层：Rukaya_Dress_Civilian 同时挂在
         CasualJacket / WinterCape 两件 Shell 外套上，不钉层就会抽到外套当躯干件，
         生成出「只穿一件外套」的平民。 -->
    <apparelTags>
      <li>Rukaya_Dress_Civilian</li>
      <li>Rukaya_Underwear</li>
    </apparelTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <apparelLayer>OnSkin</apparelLayer>
        <requiredTag>Rukaya_Dress_Civilian</requiredTag>
      </li>
    </specificApparelRequirements>
    <apparelDisallowTags>
      <li>Rukaya_PowerArmor</li>
    </apparelDisallowTags>
    <apparelRequired>
    </apparelRequired>
    <apparelAllowHeadgearChance>0.5</apparelAllowHeadgearChance>
    <weaponTags>
    </weaponTags>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>Rukaya_ChildGeneral</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>Rukaya_AdultGeneral</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
    <inventoryOptions>
      <subOptionsChooseOne>
        <li>
          <choiceChance>100</choiceChance>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>25</min>
            <max>80</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>

  <!-- 卢卡娅难民：对应原版 Royalty 的 RefugeeBase → Refugee。
       供 HAR RaceSettings 的 alienrefugeekinds / alienwandererkinds 使用
       （被追逐的难民、被追逐的加入者事件），因此必须是可加入玩家殖民地的 kind。
       装备比本族殖民者更差、战斗力更低，其余（种族、性别、背景故事、造型）完全沿用
       Rukaya_PawnBase；数值档位对照原版 Refugee：
         combatPower 35 / itemQuality Poor / gearHealthRange 0.2~0.6
         apparelMoney 90~280 / apparelAllowHeadgearChance 0.2
         chemicalAddictionChance 0.12 / backstoryCryptosleepCommonality 0.05 -->
  <PawnKindDef ParentName="Rukaya_PawnBase">
    <defName>Rukaya_Refugee</defName>
    <label>Rukaya Refugee</label>
    <!-- 中文：卢卡娅难民 -->
    <combatPower>35</combatPower>
    <itemQuality>Poor</itemQuality>
    <isFighter>false</isFighter>
    <factionLeader>false</factionLeader>
    <invNutrition>0</invNutrition>
    <gearHealthRange>0.2~0.6</gearHealthRange>
    <chemicalAddictionChance>0.12</chemicalAddictionChance>
    <backstoryCryptosleepCommonality>0.05</backstoryCryptosleepCommonality>
    <apparelMoney>90~280</apparelMoney>
    <apparelTags>
      <li>Rukaya_Dress_Civilian</li>
      <li>Rukaya_Underwear</li>
    </apparelTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <apparelLayer>OnSkin</apparelLayer>
        <requiredTag>Rukaya_Dress_Civilian</requiredTag>
      </li>
    </specificApparelRequirements>
    <apparelDisallowTags>
      <li>Rukaya_PowerArmor</li>
    </apparelDisallowTags>
    <apparelAllowHeadgearChance>0.2</apparelAllowHeadgearChance>
    <weaponTags>
    </weaponTags>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>Rukaya_ChildGeneral</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>Rukaya_AdultGeneral</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
    <inventoryOptions>
      <subOptionsChooseOne>
        <li>
          <choiceChance>100</choiceChance>
          <thingDef>Silver</thingDef>
          <countRange>
            <min>25</min>
            <max>80</max>
          </countRange>
        </li>
      </subOptionsChooseOne>
    </inventoryOptions>
  </PawnKindDef>
</Defs>
