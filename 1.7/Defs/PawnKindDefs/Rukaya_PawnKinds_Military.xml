<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================================
       军事层：民兵（Militia）→ 正规军（Regular）→ 特战队（Special Operations）
       ============================================================================
       设计依据：设计文档/卢卡娅_PawnKind四级体系与武器服装词条建议.md
       档位分配（对应 设定.md）：
         民兵      Rukaya_T1_*              非战斗服装为主，无头盔
         正规军    Rukaya_T2_*（少数越级）   野战服 + 野战护甲 + 野战钢盔
         特战队    Rukaya_T3_*              Rukaya_PowerArmor（动力装甲）
         军官/领袖 Rukaya_Officer / Rukaya_Commissar
                   → 军官礼服套装（Rukaya_Dress_Officer：礼服 + 宽檐帽），
                     配决斗剑或制式手枪
       词条语义：weaponTags / apparelTags 是白名单并集，
                 因此每个 kind 只挂「职能词条」，不与「档位词条」混写
                 （否则并集会退化回整档武器）。
                 武器职能词条由 1.6/Patches/Rukaya_PawnKindRoleTags.xml 追加到现有武器上；
                 服装身份词条（Rukaya_Dress_Civilian / _Service / _Officer / _Field）
                 直接写在各自服装 Def 的本地 <tags> 里 —— 补丁在 XmlInheritance.Resolve()
                 之前执行，看不到继承来的 <apparel>/<tags>，写进补丁会静默失效并刷红字。
       装备状态：武器全部为现有武器；正规军服装用现成美术的两套套装
                 （阿富汗卡套 = 军服 + 阿富汗卡帽；正装套 = 正装制服 + 正装贝雷帽），
                 原先三件美术占位的正规军制式装备（野战服 / 野战护甲 / 野战钢盔）
                 已按需求删除。

       【重要·动力甲泄漏防线】
       XmlInheritance 对 <li> 是「追加」语义，所以 Rukaya_Armour 与 Rukaya_ArmourHelmet /
       Rukaya_HeavyPowerArmorHelmet 的实际 tags 都包含「父级的 Rukaya_Shell / Rukaya_OverHead」
       +「自己的 Rukaya_PowerArmor」。
       而 PawnApparelGenerator.GenerateSpecificRequiredApparel 是**绕过 apparelTags 白名单**
       直接从全表取物的，因此低阶 PawnKind 若用
       <requiredTag>Rukaya_PowerArmor</requiredTag>，动力甲就会被强制选中（而且不受 apparelMoney 限制）。
       因此：
         · 民兵与平民的躯干锁位词条使用 Rukaya_Dress_Service / Rukaya_Dress_Civilian，
           不使用动力甲专用的 Rukaya_PowerArmor；
         · 同时补 apparelDisallowTags = Rukaya_PowerArmor，把预算循环那条路也堵死
           （apparelDisallowTags 只作用于预算循环，管不到 specificApparelRequirements，
            两条防线必须同时存在）。
       ============================================================================ -->

  <!-- 军官礼服套装公共基线：派系领袖（Rukaya_Commissar）与军官（Rukaya_Officer）共用。
       礼服与宽檐帽由 apparelRequired 直接点名，因此既不受 apparelTags 白名单影响、
       也不受 apparelMoney 预算影响，生成出来必定是「礼服 + 宽檐帽」整套。 -->
  <PawnKindDef ParentName="Rukaya_MilitaryPawnBase" Name="Rukaya_OfficerPawnBase" Abstract="True">
    <itemQuality>Good</itemQuality>
    <weaponMoney>500~1500</weaponMoney>
    <weaponTags>
      <li>Rukaya_T1_MeleeSword</li>
      <li>Rukaya_T2_Pistol</li>
    </weaponTags>
    <apparelMoney>2500~4000</apparelMoney>
    <apparelTags>
      <li>Rukaya_Dress_Officer</li>
      <li>Rukaya_Underwear</li>
    </apparelTags>
    <apparelDisallowTags>
      <li>Rukaya_PowerArmor</li>
    </apparelDisallowTags>
    <apparelRequired>
      <li>Rukaya_FormalDress</li>
      <li>Rukaya_WideBrimHat</li>
    </apparelRequired>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>Rukaya_ChildGeneral</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>Rukaya_AdultGeneral</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
  </PawnKindDef>

  <!-- 军事层公共基线：战斗单位、非领袖、制式品质 -->
  <PawnKindDef ParentName="Rukaya_PawnBase" Name="Rukaya_MilitaryPawnBase" Abstract="True">
    <isFighter>true</isFighter>
    <factionLeader>false</factionLeader>
    <itemQuality>Normal</itemQuality>
  </PawnKindDef>

  <!-- 特战队公共基线：精英装备、高抗性、生物锁武器 -->
  <PawnKindDef ParentName="Rukaya_MilitaryPawnBase" Name="Rukaya_SpecialOpsPawnBase" Abstract="True">
    <combatPower>240</combatPower>
    <itemQuality>Masterwork</itemQuality>
    <gearHealthRange>0.9~1.0</gearHealthRange>
    <initialWillRange>60~90</initialWillRange>
    <initialResistanceRange>60~90</initialResistanceRange>
    <biocodeWeaponChance>1.0</biocodeWeaponChance>
    <maxGenerationAge>40</maxGenerationAge>
    <minGenerationAge>24</minGenerationAge>
    <techHediffsChance>0.15</techHediffsChance>
    <techHediffsMoney>400~900</techHediffsMoney>
    <techHediffsTags>
      <li>Advanced</li>
    </techHediffsTags>
    <apparelMoney>6000~12000</apparelMoney>
    <apparelTags>
      <li>Rukaya_PowerArmor</li>
      <li>Rukaya_Underwear</li>
    </apparelTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <requiredTag>Rukaya_PowerArmor</requiredTag>
      </li>
      <li>
        <bodyPartGroup>UpperHead</bodyPartGroup>
        <requiredTag>Rukaya_PowerArmor</requiredTag>
      </li>
    </specificApparelRequirements>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>Rukaya_ChildGeneral</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>Rukaya_AdultGeneral</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
  </PawnKindDef>

