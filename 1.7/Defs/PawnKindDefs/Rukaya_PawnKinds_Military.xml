  <!-- 民兵：定居点防卫与应急战斗，装备与非战斗服装为主 -->
  <PawnKindDef ParentName="Rukaya_MilitaryPawnBase">
    <defName>Rukaya_Militia</defName>
    <label>Rukaya militia</label>
    <!-- 中文：卢卡娅民兵 -->
    <combatPower>60</combatPower>
    <gearHealthRange>0.5~1.0</gearHealthRange>
    <weaponMoney>400~1200</weaponMoney>
    <weaponTags>
      <li>Rukaya_T1_Rifle</li>
    </weaponTags>
    <apparelMoney>400~900</apparelMoney>
    <apparelTags>
      <li>Rukaya_Dress_Service</li>
      <li>Rukaya_Dress_Civilian</li>
      <li>Rukaya_Underwear</li>
    </apparelTags>
    <!-- 民兵禁动力甲：躯干锁位用 Rukaya_Dress_Service（动力甲不带该词条），
         再用 apparelDisallowTags 堵死预算循环。原因见本文件顶部说明。 -->
    <apparelDisallowTags>
      <li>Rukaya_PowerArmor</li>
    </apparelDisallowTags>
    <specificApparelRequirements>
      <li>
        <bodyPartGroup>Torso</bodyPartGroup>
        <!-- 必须钉死贴身层：只写 bodyPartGroup + requiredTag 时，
             Rukaya_TrenchCoat（Shell 外套层、同样带 Rukaya_Dress_Service、同样覆盖 Torso）
             也会被选中，于是出现「只穿一件风衣、里面什么都没穿」的生成结果
             （GenerateStartingApparelFor 的 CoatButNoShirt 重试次数有上限，重试不到就接受）。 -->
        <apparelLayer>OnSkin</apparelLayer>
        <requiredTag>Rukaya_Dress_Service</requiredTag>
      </li>
    </specificApparelRequirements>
    <backstoryFiltersOverride>
      <li>
        <categoriesChildhood>
          <li>Rukaya_ChildGeneral</li>
        </categoriesChildhood>
        <categoriesAdulthood>
          <li>Rukaya_AdultGeneral</li>
        </categoriesAdulthood>
      </li>
    </backstoryFiltersOverride>
    <skills>
      <li>
        <skill>Shooting</skill>
        <range>4~9</range>
      </li>
      <li>
        <skill>Melee</skill>
        <range>3~7</range>
      </li>
    </skills>
  </PawnKindDef>

