<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===== 服装档位约定：注释里的 1/2/3 级 = 科技等级(techLevel) = 研究前置 =====
       1级 Basic    → Rukaya_Apparel_I   + <techLevel>Medieval</techLevel>    (中世纪)
       2级 Advanced → Rukaya_Apparel_II  + <techLevel>Industrial</techLevel>  (工业)
       3级 Combat   → Rukaya_Apparel_III + <techLevel>Spacer</techLevel>      (太空)
       注：原版 TechLevel 枚举为 Undefined / Animal / Neolithic / Medieval / Industrial /
           Spacer / Ultra / Archotech，其中并没有 "Advanced"；"Advanced" 是本模组研究档位
           Rukaya_Apparel_II 的名称。新增服装时请按档位选择 Rukaya_*BaseI / BaseII / BaseIII
           作为 ParentName，并显式写出 <techLevel>。 -->

  <ThingDef Name="ApparelBase_Rukaya" ParentName="ApparelBase" Abstract="True">
    <thingClass>Apparel</thingClass>
    <category>Item</category>
    <selectable>True</selectable>
    <pathCost>10</pathCost>
    <useHitPoints>True</useHitPoints>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <onGroundRandomRotateAngle>35</onGroundRandomRotateAngle>
      <drawSize>1.5</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <drawGUIOverlay>true</drawGUIOverlay>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>1.0</DeteriorationRate>
    </statBases>
    <altitudeLayer>Item</altitudeLayer>
    <alwaysHaulable>True</alwaysHaulable>
    <tickerType>Never</tickerType>
    <burnableByRecipe>true</burnableByRecipe>
    <smeltable>true</smeltable>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
  </ThingDef>


  <ThingDef Name="Rukaya_ApparelBase" ParentName="ApparelBase_Rukaya" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <apparel>
      <useWornGraphicMask>true</useWornGraphicMask>
      <wearPerDay>0.001</wearPerDay>
      <tags>
        <li>Royal</li>
        <li>RoyalTier2</li>
        <li>RoyalTier3</li>
        <li>RoyalTier5</li>
        <li>RoyalTier6</li>
        <li>RoyalTier7</li>
      </tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <tradeability>All</tradeability>
    <tradeTags>
      <li>Apparel</li>
    </tradeTags>
    <statBases>
      <Flammability>0.4</Flammability>
      <DeteriorationRate>1</DeteriorationRate>
      <Beauty>1</Beauty>
    </statBases>
    <recipeMaker>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Tailor</effectWorking>
      <soundWorking>Recipe_Tailor</soundWorking>
      <recipeUsers>
        <li>ElectricTailoringBench</li>
        <li>HandTailoringBench</li>
      </recipeUsers>
      <unfinishedThingDef>UnfinishedApparel</unfinishedThingDef>
      <defaultIngredientFilter>
        <categories>
          <li>Root</li>
        </categories>
        <disallowedThingDefs>
          <li>Gold</li>
          <li>Silver</li>
          <li>Plasteel</li>
          <li>Jade</li>
          <li>Uranium</li>
        </disallowedThingDefs>
      </defaultIngredientFilter>
    </recipeMaker>
    <colorGenerator Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>10</weight>
          <only>(255,255,255)</only>
        </li>
      </options>
    </colorGenerator>
  </ThingDef>


</Defs>