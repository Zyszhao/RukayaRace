    <defName>Rukaya_WinterHat</defName>
    <label>Rukaya fine winter hat</label>
    <!-- 中文：卢卡娅精致防寒帽 -->
    <techLevel>Medieval</techLevel>
    <description>A finely made winter hat. Thickly knitted and folded into a broad brim that comes
      down over the ears, it keeps the head warm even in the deepest cold.</description>
    <!-- 中文翻译：做工讲究的防寒帽。厚实的针织配上宽大的翻折帽边，正好罩住兽耳，在最寒冷的环境里也能让头部保持温暖。 -->
    <graphicData>
      <texPath>Rukaya/Apparel/OverHead/WinterHat/Rukaya_WinterHat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <statBases>
      <WorkToMake>2000</WorkToMake>
      <ArmorRating_Sharp>0.06</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.05</ArmorRating_Blunt>
      <ArmorRating_Heat>0.03</ArmorRating_Heat>
      <Insulation_Cold>8</Insulation_Cold>
      <Insulation_Heat>2</Insulation_Heat>
    </statBases>
    <costList>
      <Cloth>40</Cloth>
    </costList>
    <apparel>
      <useWornGraphicMask>false</useWornGraphicMask>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
