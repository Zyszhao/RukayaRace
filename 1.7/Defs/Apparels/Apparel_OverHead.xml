    <equippedStatOffsets>
      <SocialImpact>0.10</SocialImpact>
    </equippedStatOffsets>
  </ThingDef>

  <!-- 1级（Basic）· 发带（贴图 6/RukayaOverhead3_*）· 本档最轻的一件头饰：
       防护按"较少的防护"给（低于正装贝雷帽的 0.10 一档），换社交与烹饪两端的加成。
       注：north 侧没有美术资源，按需求复制仓库内已有的同分辨率空贴图
       （OverHead/StudentHeadband/Rukaya_StudentHeadband_north.png，512x512 全透明）。 -->
  <ThingDef ParentName="Rukaya_OverheadBaseI">
    <defName>Rukaya_HairBand</defName>
    <label>Rukaya hair band</label>
    <!-- 中文：卢卡娅发带 -->
    <techLevel>Medieval</techLevel>
    <description>A plain cloth hair band that holds the hair back out of the way. Kept neat and
      simple, it makes the wearer easier to look at and keeps long hair clear of the hands, so
      kitchen work goes a little faster.</description>
    <!-- 中文翻译：一条素净的布发带，把头发束在脑后。它简单而整洁，让人看着更顺眼，也让长发不再碍手，因此厨房里的活计能快上一点。 -->
    <graphicData>
      <texPath>Rukaya/Apparel/OverHead/HairBand/Rukaya_HairBand</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <statBases>
      <Mass>0.10</Mass>
      <EquipDelay>0.4</EquipDelay>
      <WorkToMake>1000</WorkToMake>
      <ArmorRating_Sharp>0.03</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.02</ArmorRating_Blunt>
      <ArmorRating_Heat>0.02</ArmorRating_Heat>
      <Insulation_Cold>1</Insulation_Cold>
      <Insulation_Heat>1</Insulation_Heat>
    </statBases>
    <costList>
      <Cloth>15</Cloth>
    </costList>
    <apparel>
      <useWornGraphicMask>false</useWornGraphicMask>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <drawData>
        <defaultData>
          <layer>100</layer>
        </defaultData>
      </drawData>
      <wornGraphicPath>Rukaya/Apparel/OverHead/HairBand/Rukaya_HairBand</wornGraphicPath>
      <tags>
        <li>Rukaya_OverHead</li>
        <li>Rukaya_Dress_Civilian</li>
      </tags>
    </apparel>
    <equippedStatOffsets>
      <SocialImpact>0.05</SocialImpact>
      <CookSpeed>2</CookSpeed>
    </equippedStatOffsets>
  </ThingDef>

  <!-- 1级（Basic）· 宽檐帽（贴图 6/RukayaOverhead4_*）
       ===== 军官礼服套装 · 头部组件（与 Rukaya_FormalDress 成一套）=====
       两件共用身份词条 Rukaya_Dress_Officer，供派系领袖（Rukaya_Commissar）与
       军官（Rukaya_Officer）用 apparelRequired 强制整套穿着。
       成套口径（详见 Apparel_OnSkin.xml 中 Rukaya_FormalDress 的说明）：
         · 同为精制纯布料（Cloth 单料），研究与工艺同属"精工"手感；
         · 温度取向对齐在避热 12（原为 10），御寒按头饰面积取小值；
         · 加成同族：社交 + 交涉 + 从容；并用「帽子给瞄准准备、礼服给射击循环」互补。
       防护按头饰面积取礼服（0.34/0.22/0.22）的四分之一档：0.08/0.08/0.16，
       明显低于野战钢盔（0.30）与动力甲盔（0.60），符合"礼服不是战斗装"的定位。
       定位仍是原版牛仔帽的强化版：原版给 SocialImpact +0.10 与 SlaveSuppressionOffset -0.05，
       这里把压制那一项翻成正值（+0.05），再补谈判能力与出枪准备（同 Rukaya_FormalBeret）。 -->
  <ThingDef ParentName="Rukaya_OverheadBaseI">
    <defName>Rukaya_WideBrimHat</defName>
    <label>Rukaya wide-brim hat</label>
    <!-- 中文：卢卡娅宽檐帽 -->
    <techLevel>Medieval</techLevel>
    <description>A broad-brimmed hat that shades the face and keeps the sun and rain off. It lends
      the wearer a commanding silhouette - people listen a little more readily, talks go a little
      more smoothly, and those under her charge are slower to test her.</description>
    <!-- 中文翻译：一顶遮住面庞、挡开日晒雨淋的宽檐帽。它为穿着者添上一道威严的轮廓——别人更愿意听她说话，交涉也顺畅一些，而她手下的人也更不敢试探她。 -->
    <graphicData>
      <texPath>Rukaya/Apparel/OverHead/WideBrimHat/Rukaya_WideBrimHat</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <statBases>
      <Mass>0.20</Mass>
      <EquipDelay>0.8</EquipDelay>
      <WorkToMake>2600</WorkToMake>
      <ArmorRating_Sharp>0.08</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.08</ArmorRating_Blunt>
      <ArmorRating_Heat>0.16</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>12</Insulation_Heat>
    </statBases>
    <costList>
      <Cloth>40</Cloth>
    </costList>
    <apparel>
      <useWornGraphicMask>false</useWornGraphicMask>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <drawData>
        <defaultData>
          <layer>100</layer>
        </defaultData>
      </drawData>
      <wornGraphicPath>Rukaya/Apparel/OverHead/WideBrimHat/Rukaya_WideBrimHat</wornGraphicPath>
      <anyTechLevelCanUseForWarmth>true</anyTechLevelCanUseForWarmth>
      <!-- 宽檐帽只归军官礼服套装（与礼服共用身份词条）。
           2026-10-08 需求方追加要求「其他 pawnkind 不应该穿宽檐帽/礼服」：
           原先还挂着 Rukaya_Dress_Civilian（平民帽），而平民 kind 的预算循环白名单里
           正好有 Rukaya_Dress_Civilian → 平民会随机刷出宽檐帽。现已移除该词条，
           宽檐帽与礼服一样成为军官/领袖专属件。 -->
      <tags>
        <li>Rukaya_OverHead</li>
        <li>Rukaya_Dress_Officer</li>
      </tags>
    </apparel>
    <equippedStatOffsets>
      <SocialImpact>0.10</SocialImpact>
      <NegotiationAbility>0.10</NegotiationAbility>
      <AimingDelayFactor>-0.05</AimingDelayFactor>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">0.05</SlaveSuppressionOffset>
    </equippedStatOffsets>
  </ThingDef>

  <!-- 3级（Combat）· 轻型动力甲头盔：保留射击光学与伺服助力，减轻装甲和重量。
       真空抗性与重型动力甲头盔相同；战斗防护低于新加入的重型型号。
       renderSkipFlags 只显式压掉头发，保留卢卡娅耳朵绘制。 -->
  <ThingDef ParentName="Rukaya_OverheadBaseIII">
    <defName>Rukaya_ArmourHelmet</defName>
    <recipeMaker>
      <researchPrerequisites>
        <li>PoweredArmor</li>
      </researchPrerequisites>
    </recipeMaker>
    <label>Rukaya light power armor helmet</label>
    <!-- 中文：卢卡娅轻型动力甲头盔 -->
    <techLevel>Spacer</techLevel>
    <description>A lightweight powered helmet fitted with ranging optics and a servo-assisted cradle.
      Its targeting aids improve ranged accuracy, while its sealed joints provide partial protection
      in hard vacuum.</description>
    <!-- 中文翻译：一顶配有光学测距阵列与伺服助力头托的轻型动力头盔。瞄准辅助能提高远程命中精度，密封关节则可在真空中提供部分防护。 -->
    <graphicData>
      <texPath>Rukaya/Apparel/OverHead/LightPowerArmorHelmet/Rukaya_LightPowerArmorHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <statBases>
      <Mass>1.2</Mass>
      <EquipDelay>2.5</EquipDelay>
      <MaxHitPoints>160</MaxHitPoints>
      <WorkToMake>9000</WorkToMake>
      <ArmorRating_Sharp>0.35</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
      <ArmorRating_Heat>0.18</ArmorRating_Heat>
      <Insulation_Cold>4</Insulation_Cold>
      <Insulation_Heat>4</Insulation_Heat>
    </statBases>
    <costList>
      <Cloth>20</Cloth>
      <Steel>20</Steel>
      <Plasteel>10</Plasteel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Rukaya_ActiveMatterContainer>4</Rukaya_ActiveMatterContainer>
    </costList>
    <apparel>
      <useWornGraphicMask>false</useWornGraphicMask>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <renderSkipFlags>
        <li>Hair</li>
      </renderSkipFlags>
      <drawData>
        <defaultData>
          <layer>100</layer>
        </defaultData>
      </drawData>
      <wornGraphicPath>Rukaya/Apparel/OverHead/LightPowerArmorHelmet/Rukaya_LightPowerArmorHelmet</wornGraphicPath>
      <tags>
        <li>Rukaya_OverHead</li>
        <li>Rukaya_PowerArmor</li>
      </tags>
    </apparel>
    <equippedStatOffsets>
      <ShootingAccuracyPawn>4</ShootingAccuracyPawn>
      <ShootingAccuracyFactor_Long>0.05</ShootingAccuracyFactor_Long>
      <GeneralLaborSpeed>0.03</GeneralLaborSpeed>
      <AimingDelayFactor>-0.05</AimingDelayFactor>
      <VacuumResistance MayRequire="Ludeon.RimWorld.Odyssey">0.67</VacuumResistance>
    </equippedStatOffsets>
    <tradeTags>
      <li>Armor</li>
      <li>HiTechArmor</li>
    </tradeTags>
  </ThingDef>

  <!-- 3级（Combat）· 重型动力甲头盔：沿用旧动力甲头盔的高防护，并提供相同真空抗性。
       保留卢卡娅耳朵绘制；仅隐藏头发。 -->
  <ThingDef ParentName="Rukaya_OverheadBaseIII">
    <defName>Rukaya_HeavyPowerArmorHelmet</defName>
    <recipeMaker>
      <researchPrerequisites>
        <li>PoweredArmor</li>
      </researchPrerequisites>
    </recipeMaker>
    <label>Rukaya heavy power armor helmet</label>
    <!-- 中文：卢卡娅重型动力甲头盔 -->
    <techLevel>Spacer</techLevel>
    <description>A heavily plated powered helmet with a sealed visor and reinforced joints. Dense
      alloy layers protect the head, and its seals provide partial protection in hard vacuum.</description>
    <!-- 中文翻译：一顶采用厚重装甲与密封护目的动力头盔。致密合金层保护头部，密封结构还可在真空中提供部分防护。 -->
    <graphicData>
      <texPath>Rukaya/Apparel/OverHead/HeavyPowerArmorHelmet/Rukaya_HeavyPowerArmorHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <statBases>
      <Mass>1.6</Mass>
      <EquipDelay>3.5</EquipDelay>
      <MaxHitPoints>200</MaxHitPoints>
      <WorkToMake>12000</WorkToMake>
      <ArmorRating_Sharp>0.60</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Heat>0.30</ArmorRating_Heat>
      <Insulation_Cold>8</Insulation_Cold>
      <Insulation_Heat>8</Insulation_Heat>
    </statBases>
    <costList>
      <Cloth>20</Cloth>
      <Steel>30</Steel>
      <Plasteel>20</Plasteel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Rukaya_ActiveMatterContainer>4</Rukaya_ActiveMatterContainer>
    </costList>
    <apparel>
      <useWornGraphicMask>false</useWornGraphicMask>
