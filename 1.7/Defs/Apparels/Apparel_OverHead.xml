    </statBases>
    <costList>
      <Cloth>30</Cloth>
    </costList>
    <apparel>
      <useWornGraphicMask>false</useWornGraphicMask>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Rukaya/Apparel/OverHead/AfghankaHat/Rukaya_AfghankaHat</wornGraphicPath>
