  <!-- 1级（Basic）· 学生头饰 -->
  <ThingDef ParentName="Rukaya_OverheadBaseI">
    <defName>Rukaya_StudentHeadband</defName>
    <label>Rukaya student headband</label>
    <!-- 中文翻译：卢卡娅学生头饰 -->
    <techLevel>Medieval</techLevel>
    <description>A cute headband made to go with the Rukaya student uniform. It sits neatly in their
      hair and fits their ears nicely.</description>
    <!-- 中文翻译：与学生装配套的可爱头饰，能稳稳地戴在发间，也正好容得下她的耳朵。 -->

    <graphicData>
      <texPath>Rukaya/Apparel/OverHead/StudentHeadband/Rukaya_StudentHeadband</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <statBases>
      <WorkToMake>1600</WorkToMake>
      <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Heat>0.10</ArmorRating_Heat>
      <Insulation_Cold>2</Insulation_Cold>
      <Insulation_Heat>2</Insulation_Heat>
    </statBases>
    <costList>
      <Cloth>25</Cloth>
    </costList>
    <apparel>
      <useWornGraphicMask>false</useWornGraphicMask>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <drawData>
        <defaultData>
          <layer>100</layer>
        </defaultData>
      </drawData>
      <wornGraphicPath>Rukaya/Apparel/OverHead/StudentHeadband/Rukaya_StudentHeadband</wornGraphicPath>
      <!-- 身份词条必须写在叶子 Def 本地：补丁在 XmlInheritance.Resolve() 之前执行，
           看不到从 Rukaya_*BaseI/II/III 继承来的 <tags>，只能替换本地已存在的节点。 -->
      <tags>
        <li>Rukaya_OverHead</li>
        <li>Rukaya_Dress_Civilian</li>
      </tags>
    </apparel>
    <equippedStatOffsets>
      <SocialImpact>0.10</SocialImpact>
    </equippedStatOffsets>
  </ThingDef>

  <!-- 1级（Basic）· 正装贝雷帽 -->
  <ThingDef ParentName="Rukaya_OverheadBaseI">
    <defName>Rukaya_FormalBeret</defName>
    <label>Rukaya formal beret</label>
    <!-- 中文翻译：卢卡娅正装贝雷帽 -->
    <techLevel>Medieval</techLevel>
    <description>A formal beret worn with the Rukaya dress uniform, a style carried over from their
      ancient homeworld. Worn at a sharp angle to fit comfortably with their beast ears, it carries
      the fading memory of a planetary defense force that vanished into the cosmos eons ago.</description>
    <!-- 中文翻译：与正装制服配套的贝雷帽，形制同样承自卢卡娅失落的母星。斜戴的角度正好让兽耳舒适地安放，帽中还残留着那支早已消散于星海的行星防卫军的记忆。 -->
    <graphicData>
      <texPath>Rukaya/Apparel/OverHead/FormalBeret/Rukaya_FormalBeret</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
    </graphicData>
    <statBases>
      <WorkToMake>1500</WorkToMake>
      <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Heat>0.10</ArmorRating_Heat>
      <Insulation_Cold>3</Insulation_Cold>
      <Insulation_Heat>3</Insulation_Heat>
    </statBases>
    <costList>
      <Cloth>25</Cloth>
    </costList>
    <apparel>
      <useWornGraphicMask>false</useWornGraphicMask>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <bodyPartGroups>
        <li>UpperHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Rukaya/Apparel/OverHead/FormalBeret/Rukaya_FormalBeret</wornGraphicPath>
      <tags>
        <li>Rukaya_OverHead</li>
        <li>Rukaya_Dress_Service</li>
      </tags>
    </apparel>
    <equippedStatOffsets>
      <AimingDelayFactor>-0.05</AimingDelayFactor>
    </equippedStatOffsets>
  </ThingDef>
