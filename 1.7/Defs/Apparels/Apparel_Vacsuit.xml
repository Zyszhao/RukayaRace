<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>Rukaya_Vacsuit</defName>
    <label>Rukaya vacsuit</label>
    <!-- 中文翻译：卢卡娅真空服 -->
    <description>A protective suit that keeps the user safe in the vacuum of space. The suit restricts the wearer's movement, considerably reducing their movement speed.</description>
    <!-- 中文翻译：一套可在太空中保障使用者安全的防护服。但会约束穿戴者行动，显著降低其行动速度。 -->
    <generateAllowChance>0</generateAllowChance>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Rukaya/Apparel/OnSkin/Vacsuit/Rukaya_Vacsuit</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.5</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <statBases>
      <WorkToMake>48000</WorkToMake>
      <MaxHitPoints>180</MaxHitPoints>
      <Mass>12</Mass>
      <Flammability>0.4</Flammability>
      <!-- 外层本体数值按原版 Vacsuit 保留；贴身服装仍穿着并独立贡献属性。 -->
      <ArmorRating_Sharp>0.52</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Heat>0.66</ArmorRating_Heat>
      <Insulation_Cold>90</Insulation_Cold>
      <Insulation_Heat>15</Insulation_Heat>
      <EquipDelay>14</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-1.25</MoveSpeed>
      <VacuumResistance>0.32</VacuumResistance>
    </equippedStatOffsets>
    <thingCategories>
      <li>ApparelArmor</li>
      <li>Rukaya_Apparel_Shell</li>
    </thingCategories>
    <tradeTags>
      <li>HiTechArmor</li>
      <li>Armor</li>
    </tradeTags>
    <smeltable>true</smeltable>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Rukaya/Apparel/OnSkin/Vacsuit/Rukaya_Vacsuit</wornGraphicPath>
      <layers Inherit="False">
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
        <li>Vacsuit</li>
        <li>Rukaya_Shell</li>
      </tags>
      <defaultOutfitTags>
        <li>Spacefarer</li>
      </defaultOutfitTags>
      <useDeflectMetalEffect>true</useDeflectMetalEffect>
      <soundWear>Wear_PowerArmor</soundWear>
      <soundRemove>Remove_PowerArmor</soundRemove>
      <useWornGraphicMask>false</useWornGraphicMask>
    </apparel>
    <thingSetMakerTags>
      <li>RewardStandardMidFreq</li>
    </thingSetMakerTags>
    <costList>
      <ComponentIndustrial>3</ComponentIndustrial>
      <Steel>90</Steel>
      <Plasteel>20</Plasteel>
    </costList>
    <recipeMaker>
      <researchPrerequisite>OrbitalTech</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <displayPriority>235</displayPriority>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers Inherit="False">
        <li>Rukaya_Fabricator</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>
  <ThingDef ParentName="ArmorHelmetMakeableBase" MayRequire="Ludeon.RimWorld.Odyssey">
    <defName>Rukaya_VacsuitHelmet</defName>
    <label>Rukaya vacsuit helmet</label>
    <!-- 中文翻译：卢卡娅真空头盔 -->
    <description>A helmet that efficiently recycles the user's oxygen, allowing them to breathe in the vacuum of space for hours at a time. The process isn't perfectly efficient, so the user must periodically return to a pressurized environment.</description>
    <!-- 中文翻译：一款能高效回收使用者氧气的头盔，使其能在太空真空中持续呼吸数小时。由于氧气转化过程并非完美无缺，使用者仍需定期返回加压环境。 -->
    <possessionCount>1</possessionCount>
    <generateAllowChance>0</generateAllowChance>
    <techLevel>Spacer</techLevel>
    <graphicData>
      <texPath>Rukaya/Apparel/OverHead/VacsuitHelmet/Rukaya_VacsuitHelmet</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.5</drawSize>
      <drawOffset>(0,0,0)</drawOffset>
    </graphicData>
    <statBases>
      <WorkToMake>15000</WorkToMake>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>1.5</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>0.52</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.24</ArmorRating_Blunt>
      <ArmorRating_Heat>0.66</ArmorRating_Heat>
      <Insulation_Cold>6</Insulation_Cold>
      <Insulation_Heat>4</Insulation_Heat>
      <EquipDelay>4</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <ToxicEnvironmentResistance>0.8</ToxicEnvironmentResistance>
      <VacuumResistance>0.69</VacuumResistance>
    </equippedStatOffsets>
    <smeltable>true</smeltable>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <developmentalStageFilter>Child, Adult</developmentalStageFilter>
      <immuneToToxGasExposure>true</immuneToToxGasExposure>
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Rukaya/Apparel/OverHead/VacsuitHelmet/Rukaya_VacsuitHelmet</wornGraphicPath>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>SpacerMilitary</li>
        <li>Vacsuit</li>
        <li>Rukaya_OverHead</li>
      </tags>
      <forceEyesVisibleForRotations>
        <li>1</li>
        <li>2</li>
        <li>3</li>
      </forceEyesVisibleForRotations>
      <defaultOutfitTags>
        <li>Spacefarer</li>
      </defaultOutfitTags>
      <useWornGraphicMask>false</useWornGraphicMask>
      <renderSkipFlags>
        <li>Hair</li>
        <li>Rukaya_HideHair</li>
        <li>Rukaya_HideEars</li>
      </renderSkipFlags>
    </apparel>
    <tradeTags>
      <li>HiTechArmor</li>
      <li>Armor</li>
    </tradeTags>
    <thingSetMakerTags>
      <li>RewardStandardMidFreq</li>
    </thingSetMakerTags>
    <costList>
      <ComponentIndustrial>2</ComponentIndustrial>
      <Steel>40</Steel>
    </costList>
    <recipeMaker>
      <researchPrerequisite>OrbitalTech</researchPrerequisite>
      <unfinishedThingDef>UnfinishedTechArmor</unfinishedThingDef>
      <displayPriority>237</displayPriority>
      <workSpeedStat>GeneralLaborSpeed</workSpeedStat>
      <workSkill>Crafting</workSkill>
      <effectWorking>Smith</effectWorking>
      <soundWorking>Recipe_Smith</soundWorking>
      <recipeUsers Inherit="False">
        <li>Rukaya_Fabricator</li>
      </recipeUsers>
    </recipeMaker>
    <thingCategories>
      <li>Rukaya_Apparel_Overhead</li>
    </thingCategories>
  </ThingDef>
</Defs>
