<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- 四件内衣沿用黑色过膝袜内衣的基础属性，不增加竞技紧身衣或运动内衣的专属加成。 -->
  <ThingDef ParentName="Rukaya_UnderwearBaseI">
    <defName>Rukaya_FishnetStockings</defName>
    <label>Rukaya fishnet underwear</label>
    <!-- 中文：卢卡娅渔网袜内衣 -->
    <description>A set of underwear with fishnet stockings, tailored for Rukaya anatomy.</description>
    <!-- 中文翻译：一套为卢卡娅体型裁制、配有渔网袜的内衣。 -->
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Rukaya/Apparel/Underwear/FishnetStockings/Rukaya_FishnetStockings</texPath>
    </graphicData>
    <apparel>
      <useWornGraphicMask>false</useWornGraphicMask>
      <bodyPartGroups><li>Torso</li><li>Legs</li></bodyPartGroups>
      <wornGraphicPath>Rukaya/Apparel/Underwear/FishnetStockings/Rukaya_FishnetStockings</wornGraphicPath>
      <tags><li>Rukaya_Underwear</li><li>Rukaya_Dress_Civilian</li></tags>
    </apparel>
  </ThingDef>

