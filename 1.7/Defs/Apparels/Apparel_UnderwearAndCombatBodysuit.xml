  <ThingDef ParentName="Rukaya_UnderwearBaseI">
    <defName>Rukaya_BandageUnderwear</defName>
    <label>Rukaya bandage underwear</label>
    <!-- 中文：卢卡娅绷带内衣 -->
    <description>Underwear made from soft cloth wraps, fitted securely around the Rukaya body.</description>
    <!-- 中文翻译：以柔软布带缠绕而成的内衣，稳妥贴合卢卡娅的身体。 -->
