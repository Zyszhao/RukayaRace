<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <PawnsArrivalModeDef>
    <defName>Rukaya_Airborne</defName>
    <label>airborne</label>
    <!-- 中文：空降 -->
    <workerClass>RukayaAviation.PawnsArrivalModeWorker_RukayaAirborne</workerClass>
    <layerWhitelist>
      <li>Surface</li>
    </layerWhitelist>
    <selectionWeightCurve>
      <points>
        <li>(0, 0)</li>
      </points>
    </selectionWeightCurve>
    <selectionWeightCurvesPerFaction>
      <li>
        <faction>Rukaya_DrifterAlliance</faction>
        <selectionWeightPerPointsCurve>
          <points>
            <li>(0, 0.25)</li>
            <li>(300, 0.7)</li>
            <li>(800, 2.5)</li>
            <li>(2000, 3.5)</li>
          </points>
        </selectionWeightPerPointsCurve>
      </li>
      <li>
        <faction>Rukaya_BrokenStarCorps</faction>
        <selectionWeightPerPointsCurve>
          <points>
            <li>(0, 0.25)</li>
            <li>(300, 0.7)</li>
            <li>(800, 2.5)</li>
            <li>(2000, 3.5)</li>
          </points>
        </selectionWeightPerPointsCurve>
      </li>
    </selectionWeightCurvesPerFaction>
    <pointsFactorCurve>
      <points>
        <li>0, 0.75</li>
        <li>5000, 0.55</li>
      </points>
    </pointsFactorCurve>
    <minTechLevel>Industrial</minTechLevel>
    <textEnemy>Rukaya transport aircraft carrying {0} from {1} have entered the airspace and are deploying airborne troops!</textEnemy>
    <!-- 中文翻译：搭载着来自{1}的{0}的卢卡娅运输机已飞入空域，正在实施空降突袭！ -->
    <textFriendly>Friendly Rukaya transport aircraft carrying {0} from {1} have entered the airspace and are deploying airborne reinforcements.</textFriendly>
    <!-- 中文翻译：搭载着来自{1}的友方{0}的卢卡娅运输机已飞入空域，正在空降增援。 -->
    <textWillArrive>{0_pawnsPluralDef} will arrive by airborne drop from Rukaya transport aircraft.</textWillArrive>
    <!-- 中文翻译：{0_pawnsPluralDef}将乘坐卢卡娅运输机实施空降。 -->
  </PawnsArrivalModeDef>

  <ThingDef ParentName="SkyfallerBase">
    <defName>Rukaya_AirborneRaidFlyer</defName>
    <label>airborne Rukaya</label>
    <!-- 中文：空降卢卡娅 -->
    <thingClass>RukayaAviation.Skyfaller_RukayaAirborneDrop</thingClass>
    <skyfaller>
      <hitRoof>false</hitRoof>
      <motesPerCell>0</motesPerCell>
      <ticksToImpactRange>90~125</ticksToImpactRange>
      <movementType>Decelerate</movementType>
      <shadowSize>0.75</shadowSize>
      <angleCurve>
        <points><li>(0, -90)</li><li>(1, -90)</li></points>
      </angleCurve>
      <speedCurve>
        <points><li>(0, 0.10)</li><li>(1, 0.03)</li></points>
      </speedCurve>
      <zPositionCurve>
        <points><li>(0, 0)</li><li>(1, 0)</li></points>
      </zPositionCurve>
    </skyfaller>
  </ThingDef>
</Defs>
