            <li>
              <tick>0</tick>
              <graphicState>Rukaya_WingFlapSouth_0</graphicState>
            </li>
            <li>
              <tick>4</tick>
              <graphicState>Rukaya_WingFlapSouth_1</graphicState>
            </li>
            <li>
              <tick>8</tick>
              <graphicState>Rukaya_WingFlapSouth_2</graphicState>
            </li>
            <li>
              <tick>12</tick>
              <graphicState>Rukaya_WingFlapSouth_3</graphicState>
            </li>
            <li>
              <tick>16</tick>
              <graphicState>Rukaya_WingFlapSouth_4</graphicState>
            </li>
            <li>
              <tick>20</tick>
              <graphicState>Rukaya_WingFlapSouth_5</graphicState>
            </li>
            <li>
              <tick>24</tick>
              <graphicState>Rukaya_WingFlapSouth_6</graphicState>
            </li>
            <li>
              <tick>28</tick>
              <graphicState>Rukaya_WingFlapSouth_7</graphicState>
            </li>
            <!-- 循环收尾：这一拍交还给第 1 张图（末关键帧 tick 必须等于 durationTicks，见文件头说明）。 -->
            <li>
              <tick>32</tick>
              <graphicState>Rukaya_WingFlapSouth_0</graphicState>
            </li>
          </keyframes>
        </value>
      </li>
      <li>
        <key>Rukaya_WingFlapFront</key>
        <value>
          <workerType>AnimationWorker_Keyframes</workerType>
          <keyframes>
            <li>
              <tick>0</tick>
              <graphicState>Rukaya_WingFlapSouth_0</graphicState>
            </li>
            <li>
              <tick>4</tick>
              <graphicState>Rukaya_WingFlapSouth_1</graphicState>
            </li>
            <li>
              <tick>8</tick>
              <graphicState>Rukaya_WingFlapSouth_2</graphicState>
            </li>
            <li>
              <tick>12</tick>
              <graphicState>Rukaya_WingFlapSouth_3</graphicState>
            </li>
            <li>
              <tick>16</tick>
              <graphicState>Rukaya_WingFlapSouth_4</graphicState>
            </li>
            <li>
              <tick>20</tick>
              <graphicState>Rukaya_WingFlapSouth_5</graphicState>
            </li>
            <li>
              <tick>24</tick>
              <graphicState>Rukaya_WingFlapSouth_6</graphicState>
            </li>
            <li>
              <tick>28</tick>
              <graphicState>Rukaya_WingFlapSouth_7</graphicState>
            </li>
            <!-- 循环收尾：这一拍交还给第 1 张图（末关键帧 tick 必须等于 durationTicks，见文件头说明）。 -->
            <li>
              <tick>32</tick>
              <graphicState>Rukaya_WingFlapSouth_0</graphicState>
            </li>
          </keyframes>
        </value>
      </li>
      <!--
        浮动：Root 分部的 offset 关键帧。
        offset 第三分量 = 世界 Z（高度）；引擎在各关键帧之间做 Vector3.Lerp，
        所以这里是平滑起伏而非跳变。
        末帧 tick 必须等于 durationTicks（=32），否则 tick 32 之后会被钳位成"停住不动"。
        四个方向（South/North/East/West）的 Root 分部完全同构：纯垂直浮动，不带躯干角。
        相位与翅膀帧对齐：翅膀在 tick 16 下压到底（第 5 张图），身体在 tick 15 抬到最高，
        形成"扇翅推升 → 自然回落"的物理感。
      -->
      <li>
        <key>Root</key>
        <value>
          <workerType>AnimationWorker_Keyframes</workerType>
          <keyframes>
            <li>
              <tick>0</tick>
              <offset>(0,0,-0.0125)</offset>
            </li>
            <li>
              <tick>10</tick>
              <offset>(0,0,0.01)</offset>
            </li>
            <li>
              <tick>15</tick>
              <offset>(0,0,0.0125)</offset>
            </li>
            <li>
              <tick>32</tick>
              <offset>(0,0,-0.0125)</offset>
            </li>
          </keyframes>
        </value>
      </li>
    </keyframeParts>
  </AnimationDef>
