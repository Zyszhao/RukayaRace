<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ============================================================
       Rukaya 机械体（Mechanoids）· 培养配方
       制造场所：LargeMechGestator（大型机械培育舱）
         —— 通过公共父配方的 recipeUsers 显式挂载，重量等级不会自动分配制造设施。
       研究前置：Rukaya_Mechanoid_I（卢卡娅机械体）；导弹型另需 Rukaya_AirDefenseMissiles。
       ============================================================ -->

  <RecipeDef Name="Rukaya_BaseMechanoidRecipe" ParentName="BaseMechanoidRecipe" Abstract="True">
    <gestationCycles>6</gestationCycles>
    <displayPriority>320</displayPriority>
    <researchPrerequisite>Rukaya_Mechanoid_I</researchPrerequisite>
    <recipeUsers>
      <li>LargeMechGestator</li>
    </recipeUsers>
    <ingredients Inherit="False">
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>255</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Plasteel</li>
          </thingDefs>
        </filter>
        <count>355</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>8</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>SubcoreHigh</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
  </RecipeDef>

  <RecipeDef ParentName="Rukaya_BaseMechanoidRecipe">
    <defName>Rukaya_GestateMechanoid_Rocket</defName>
    <label>培育卢卡娅通用机械“火箭型”</label>
    <!-- 中文：培育卢卡娅通用机械“火箭型” -->
    <description>Gestate a dedicated Rukaya mechanoid armed with a multi-tube rocket launcher turret.</description>
    <!-- 中文翻译：培育一台基于标准卢卡娅机械底盘的专用机械体，装备多管火箭发射巢。 -->
    <descriptionHyperlinks>
      <ThingDef>Rukaya_MechChassis_Rocket</ThingDef>
    </descriptionHyperlinks>
    <products>
      <Rukaya_MechChassis_Rocket>1</Rukaya_MechChassis_Rocket>
    </products>
  </RecipeDef>

