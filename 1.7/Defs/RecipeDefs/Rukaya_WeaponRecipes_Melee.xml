  <RecipeDef ParentName="Rukaya_MakeMeleeWeaponBase">
    <defName>Make_Rukaya_Pickaxe</defName>
    <label>forge field pickaxe</label>
    <!-- 中文翻译：锻造十字镐 -->
    <workAmount>9000</workAmount>
    <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Steel</li>
          </thingDefs>
        </filter>
        <count>65</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>ComponentIndustrial</li>
          </thingDefs>
        </filter>
        <count>1</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Steel</li>
        <li>ComponentIndustrial</li>
      </thingDefs>
    </fixedIngredientFilter>
    <products>
      <Rukaya_Pickaxe>1</Rukaya_Pickaxe>
    </products>
    <researchPrerequisite>Rukaya_Weapon_I</researchPrerequisite>
    <skillRequirements>
      <Crafting>4</Crafting>
    </skillRequirements>
    <displayPriority>405</displayPriority>
  </RecipeDef>

