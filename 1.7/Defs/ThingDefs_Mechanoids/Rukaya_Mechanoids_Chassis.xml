  <!-- 火箭型：多管火箭发射巢 -->
  <ThingDef ParentName="Rukaya_BaseMechChassis">
    <defName>Rukaya_MechChassis_Rocket</defName>
    <label>Rukaya rocket mechanoid</label>
    <!-- 中文：卢卡娅通用机械“火箭型” -->
