<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <HediffDef>
    <defName>Rukaya_InFlight</defName>
    <label>in flight</label>
    <!-- 中文：飞行中 -->
    <description>This Rukaya is airborne on her own wings.</description>
    <!-- 中文翻译：这名卢卡娅正以自己的双翼停留在空中。翅膀的每一次扇动都在维持升力，同时也让她更难被近战命中。 -->
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <maxSeverity>1.0</maxSeverity>
    <initialSeverity>1.0</initialSeverity>
    <everCurableByItem>false</everCurableByItem>
    <defaultLabelColor>(0.6,0.8,0.6)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_DisappearsOnDeath"/>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <MeleeDodgeChance>2</MeleeDodgeChance>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>
</Defs>
