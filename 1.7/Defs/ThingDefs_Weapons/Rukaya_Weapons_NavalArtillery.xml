<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 舰炮炮身：装在 Rukaya_NavalArtillery 的 building.turretGunDef 上。
       贴图 = **炮塔顶层**（TurretTop 用 turretGunDef.graphicData.texPath 绘制，与炮管同画布、同比例）。
       炮管是独立的一层，由 RukayaRace.Buildings.Building_RukayaNavalArtillery 画在本层与底座之间；
       两层都用同一个 aim 角度旋转，所以永远同步（详见建筑 def 文件头【三层贴图】）。 -->

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>Rukaya_Gun_NavalArtillery</defName>
    <label>naval artillery cannon</label>
    <!-- 中文：舰炮炮身 -->
    <description>A self-loading Rukaya naval cannon designed to attach to an emplacement turret. It feeds on
      sealed active matter containers instead of conventional shells, and throws paired rounds from its twin
      barrels on a flat, high-velocity trajectory.</description>
    <!-- 中文翻译：一门为炮塔底座设计的卢卡娅自装填舰炮。它以密封的活性物质容器而非传统炮弹为供弹，并由双联炮管以高初速平射弹道成对发射炮弹。 -->
    <graphicData>
      <texPath>Rukaya/Building/Rukaya_NavalArtillery/Rukaya_NavalArtillery_turret_top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>90</Mass>
      <Beauty>-3</Beauty>
      <SellPriceFactor>0.2</SellPriceFactor>
      <AccuracyTouch>0.55</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.9</AccuracyMedium>
      <AccuracyLong>0.85</AccuracyLong>
      <RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>RukayaRace.Weapons.Verb_RukayaNavalArtilleryShoot</verbClass>
        <defaultProjectile>Bullet_Rukaya_NavalArtilleryShell</defaultProjectile>
        <warmupTime>1.5</warmupTime>
        <minRange>9.9</minRange>
        <range>55.9</range>
        <!-- 爆炸弹丸必须开启 forced miss（1.6 VerbProperties.ConfigErrors 硬性校验：
             forcedMissRadius > 0 必须与 CausesExplosion 一致，Projectile_Explosive 即为 true）。
             取值 1.9 对齐原版末日火箭：≥7 格距离时散布恒为 1.9 格，该距离内不再做精度判定；
             3 格内 adjusted 半径归零，退回精度判定（ShootingAccuracyTurret 0.96 在此生效）。
             双联两发各自独立抽样落点，因此齐射本身就是一对散开的炮弹。 -->
        <forcedMissRadius>1.9</forcedMissRadius>
        <ticksBetweenBurstShots>180</ticksBetweenBurstShots>
        <burstShotCount>2</burstShotCount>
        <consumeFuelPerShot>4</consumeFuelPerShot>
        <ai_AvoidFriendlyFireRadius>3.5</ai_AvoidFriendlyFireRadius>
        <soundCast>Mortar_LaunchA</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>18</muzzleFlashScale>
      </li>
    </verbs>
  </ThingDef>

  <!-- 舰炮炮弹：对照原版 Bullet_Shell_HighExplosive（speed 41 / 爆炸半径 2.9 / AP 0.10 / flyOverhead true）
       —— 更快、爆炸范围更大、穿甲更强，且走平射而非越顶弹道。 -->

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_Rukaya_NavalArtilleryShell</defName>
    <label>naval artillery shell</label>
    <!-- 中文：舰炮炮弹 -->
    <graphicData>
      <texPath>Things/Projectile/ShellHighExplosive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>50</damageAmountBase>
      <armorPenetrationBase>0.30</armorPenetrationBase>
      <speed>80</speed>
      <explosionRadius>3.3</explosionRadius>
      <flyOverhead>false</flyOverhead>
      <soundExplode>MortarBomb_Explode</soundExplode>
      <soundImpactAnticipate>MortarRound_PreImpact</soundImpactAnticipate>
      <soundAmbient>MortarRound_Ambient</soundAmbient>
      <preExplosionSpawnSingleThingDef>Filth_BlastMark</preExplosionSpawnSingleThingDef>
    </projectile>
  </ThingDef>

  <!-- ============================================================
       舰炮的对空射击组件（组件自己那把炮身，**不共用**上面那门主炮）

       为什么必须单独一门炮身：设计口径要求对空系统"不占用宿主的 verb，与它的 burst 状态
       互不干扰"（设计文档/分层防空系统_实现交接.md §7.2）。主炮是 burstShotCount=2 /
       ticksBetweenBurstShots=180 的地面连发炮：若被对空共用，一次对空射击只消耗连发里的一发，
       剩下那发会在 3 秒后打到已经消失的目标上，同时把主炮的对地节奏搅乱。
       单独一门炮身 = 单发、独立 burst 状态机、独立冷却，主机地面射击完全不受影响。

       装填与主炮同价：consumeFuelPerShot 4（caster 就是炮塔本体，扣的是炮塔那 300 点活性物质）。
       组件载体模式下不跑地面索敌、也不自绘炮身：对空交战时由
       Patch_TurretTop_TurretTopTick_RukayaAirAim 把宿主炮塔顶扳向空中目标。
       ============================================================ -->

  <ThingDef ParentName="BaseWeaponTurret">
    <defName>Rukaya_Gun_NavalArtilleryAA</defName>
    <label>naval artillery air-defense cluster</label>
    <!-- 中文：舰炮对空射击组件 -->
    <description>An air-defense cluster slaved to a Rukaya naval artillery mount. It seeks out incoming drop
      pods and meteorites on its own mount and leaves the main gun's ground fire untouched.</description>
    <!-- 中文翻译：一套从属于卢卡娅舰炮炮塔的对空射击组件。它用自己的炮架自行搜索并拦截来袭的空投仓与陨石，不影响主炮的对地射击。 -->
    <graphicData>
      <texPath>Rukaya/Building/Rukaya_NavalArtillery/Rukaya_NavalArtillery_turret_top</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <useHitPoints>false</useHitPoints>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
      <Mass>20</Mass>
      <Beauty>-1</Beauty>
      <SellPriceFactor>0.2</SellPriceFactor>
      <AccuracyTouch>0.8</AccuracyTouch>
      <AccuracyShort>0.8</AccuracyShort>
      <AccuracyMedium>0.8</AccuracyMedium>
      <AccuracyLong>0.8</AccuracyLong>
      <RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>RukayaRace.AirDefense.Verb_RukayaSkyInterceptorShoot</verbClass>
        <defaultProjectile>Bullet_Rukaya_InterceptorMissile</defaultProjectile>
        <range>55.9</range>
        <!-- 炮弹/PawnFlyer 等局部目标使用组件 airDefenseRange（默认35格）；
             允许的空投仓与自然天降物全图拦截。这里的 range 不限制对空交战。 -->
        <warmupTime>0.5</warmupTime>
        <!-- 普通目标预热0.5秒，空投仓预热由组件压至6tick；已发射拦截弹按下落期限加速收尾。 -->
        <burstShotCount>1</burstShotCount>
        <!-- 单发：一次触发放一枚拦截弹，不留待发的第二发。 -->
        <defaultCooldownTime>2.0</defaultCooldownTime>
        <consumeFuelPerShot>4</consumeFuelPerShot>
        <!-- 与主炮同价：一次对空射击也扣 4 单位活性物质。 -->
        <soundCast>Mortar_LaunchA</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>14</muzzleFlashScale>
        <forcedMissRadius>0</forcedMissRadius>
        <!-- 对空命中完全由 RukayaAirImpact 结算，不走原版散布；0 也避开与 CausesExplosion 的校验冲突。 -->
      </li>
    </verbs>
  </ThingDef>

  <!-- 拦截弹「模板」Def：Projectile_RukayaSkyInterceptor 从它取飞行速度与飞行贴图，
       实际落地的实体是 Rukaya_SkyInterceptorAirProjectile（见 ThingDefs_Misc/Rukaya_SkyInterception.xml）。
       贴图口径（需求方 2026-10-08 实测反馈）：与舰炮地面炮弹 **同一张** Things/Projectile/ShellHighExplosive，
       不再借用 Rukaya/Weapon/Rukaya_ATGM_Projectile（那是反装甲导弹的专用贴图）。
       这里刻意不写 drawSize：与地面炮弹一样继承 BaseBullet 的尺寸，两者观感完全一致。
       speed 200 ⇒ 2 格/tick：这个值直接决定玩家能不能看清拦截弹飞过去。
       对空动画具有最短飞行时长，并按目标下落期限自动加速，避免全图拦截在落地之后才结算。 -->
  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_Rukaya_InterceptorMissile</defName>
    <label>interceptor missile</label>
    <!-- 中文：拦截弹 -->
    <graphicData>
      <texPath>Things/Projectile/ShellHighExplosive</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <projectile>
      <damageDef>Blunt</damageDef>
      <damageAmountBase>0</damageAmountBase>
      <speed>200</speed>
    </projectile>
  </ThingDef>

</Defs>
