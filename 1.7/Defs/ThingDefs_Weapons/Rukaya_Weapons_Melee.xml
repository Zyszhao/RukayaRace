  <ThingDef ParentName="Rukaya_BaseT1MeleeWeapon">
    <defName>Rukaya_Pickaxe</defName>
    <label>Rukaya field pickaxe</label>
    <!-- 中文翻译：卢卡娅十字镐 -->
    <description>A reinforced field pick issued as both breaching tool and emergency weapon. It is tiring to swing and not especially lethal in a duel, but its weighted head bites through armor better than improvised tools.</description>
    <!-- 中文翻译：一种兼作破拆工具与应急武器的强化工兵十字镐。它挥动起来很吃力，在决斗里也不算致命，但加重的镐头比临时工具更容易啃穿护甲。 -->
    <graphicData>
      <texPath>Rukaya/Weapon/Rukaya_Pickaxe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <WorkToMake>9000</WorkToMake>
      <Mass>2.8</Mass>
    </statBases>
    <costList>
      <Steel>65</Steel>
      <ComponentIndustrial>1</ComponentIndustrial>
    </costList>
    <weaponTags>
      <li>Rukaya_T1_Melee</li>
    </weaponTags>
    <tools>
      <li>
        <label>haft</label> <!-- 中文：柄 -->
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2.4</cooldownTime>
      </li>
      <li>
        <label>spike</label> <!-- 中文：镐尖 -->
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2.7</cooldownTime>
      </li>
      <li>
        <label>spike</label> <!-- 中文：镐尖 -->
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>15</power>
        <cooldownTime>2.7</cooldownTime>
      </li>
      <li>
        <label>breaching spike</label> <!-- 中文：破拆镐尖 -->
        <capacities>
          <li>Demolish</li>
        </capacities>
        <power>7.5</power>
        <cooldownTime>1</cooldownTime>
      </li>
    </tools>
  </ThingDef>

