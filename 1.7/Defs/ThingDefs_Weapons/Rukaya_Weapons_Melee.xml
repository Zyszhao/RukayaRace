  <ThingDef ParentName="Rukaya_BaseActiveMatterMeleeWeapon">
    <defName>Rukaya_SledgeHammer</defName>
    <label>Rukaya breaching sledgehammer</label>
    <!-- 中文翻译：卢卡娅爆破锤 -->
